{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "fs:default",
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$HOME/**" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$HOME/**" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$HOME/**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$HOME/**" }]
    },
    "shell:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "claude",
          "cmd": "/Users/mdeeb95/.local/bin/claude",
          "args": true
        },
        {
          "name": "sh",
          "cmd": "sh",
          "args": true
        },
        {
          "name": "wlrctl",
          "cmd": "wlrctl",
          "args": true
        },
        {
          "name": "wmctrl",
          "cmd": "wmctrl",
          "args": true
        },
        {
          "name": "osascript",
          "cmd": "osascript",
          "args": true
        },
        {
          "name": "npm",
          "cmd": "npm",
          "args": true
        },
        {
          "name": "npx",
          "cmd": "npx",
          "args": true
        },
        {
          "name": "python3",
          "cmd": "python3",
          "args": true
        },
        {
          "name": "cargo",
          "cmd": "cargo",
          "args": true
        },
        {
          "name": "make",
          "cmd": "make",
          "args": true
        },
        {
          "name": "godot",
          "cmd": "godot",
          "args": true
        },
        {
          "name": "grim",
          "cmd": "grim",
          "args": true
        },
        {
          "name": "scrot",
          "cmd": "scrot",
          "args": true
        },
        {
          "name": "screencapture",
          "cmd": "screencapture",
          "args": true
        },
        {
          "name": "arecord",
          "cmd": "arecord",
          "args": true
        },
        {
          "name": "rec",
          "cmd": "rec",
          "args": true
        },
        {
          "name": "whisper",
          "cmd": "whisper",
          "args": true
        },
        {
          "name": "git",
          "cmd": "git",
          "args": true
        },
        {
          "name": "vercel",
          "cmd": "vercel",
          "args": true
        },
        {
          "name": "railway",
          "cmd": "railway",
          "args": true
        },
        {
          "name": "netlify",
          "cmd": "netlify",
          "args": true
        },
        {
          "name": "gh",
          "cmd": "gh",
          "args": true
        }
      ]
    },
    "shell:allow-stdin-write",
    "shell:allow-kill",
    "dialog:default",
    "dialog:allow-open"
  ]
}
