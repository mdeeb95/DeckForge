# ─── LLM API Keys (at least one required) ────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...

# ─── Database ─────────────────────────────────────────────────────────────────
# Local dev (default — SQLite, no setup needed):
#   DATABASE_URL=sqlite+aiosqlite:///./deckforge.db
#
# Railway production (auto-injected when PostgreSQL service is linked):
#   DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/railway
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/deckforge

# ─── Langfuse (observability) ─────────────────────────────────────────────────
# On Railway: set these manually in the service variables panel.
# LANGFUSE_HOST should point to your self-hosted Langfuse instance on Railway.
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=https://langfuse.your-railway-app.railway.app

# ─── Auth ─────────────────────────────────────────────────────────────────────
# IMPORTANT: Change JWT_SECRET to a strong random value in production.
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── CORS (comma-separated origins) ──────────────────────────────────────────
# Railway: add your frontend domain and tauri:// scheme.
ALLOWED_ORIGINS=tauri://localhost,http://localhost:1420,http://localhost:8000

# ─── Server ───────────────────────────────────────────────────────────────────
# Railway auto-injects PORT. Do not set it manually on Railway.
HOST=0.0.0.0
PORT=8000
